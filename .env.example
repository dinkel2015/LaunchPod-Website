# Vercel project environment variables for the LaunchPod portal.
# Copy into the Vercel dashboard (Project -> Settings -> Environment Variables).
# NOTHING in this file belongs in git with real values, and nothing here is
# safe to inline in portal.html except the two marked PUBLIC.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=              # PUBLIC — safe in portal.html
SUPABASE_SERVICE_ROLE_KEY=      # SECRET — /api only, bypasses RLS

# --- Square ---
SQUARE_ENV=sandbox              # 'sandbox' or 'production'; no default is assumed
SQUARE_APPLICATION_ID=          # PUBLIC — safe in portal.html
SQUARE_LOCATION_ID=             # PUBLIC — safe in portal.html
SQUARE_ACCESS_TOKEN=            # SECRET — /api only

# --- ClickUp ---
CLICKUP_API_TOKEN=              # SECRET — /api only
CLICKUP_TEAM_ID=90132069393
CLICKUP_DELIVERY_SPACE_ID=901310342875
# Set once "Client Template Folder" has been saved as a Folder Template in
# the ClickUp UI. Get the t-prefixed id from
#   GET https://api.clickup.com/api/v2/team/90132069393/folder_template
# Left unset, provisioning builds the folder and lists explicitly instead.
CLICKUP_FOLDER_TEMPLATE_ID=

# --- Internal ---
# Shared secret for the Vercel Cron route and server-to-server provisioning.
# Generate with: openssl rand -hex 32
CRON_SECRET=
